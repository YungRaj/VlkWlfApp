#!/usr/bin/env bash
set -u

RT="/tmp/vkwlf-xdg-$(id -u)"
mkdir -p "$RT"
chmod 700 "$RT"
SOCK="$RT/wayland-0"

cleanup() {
  pkill -x antigravity 2>/dev/null || true
  [[ -n "${PROXY_PID:-}" ]] && kill "$PROXY_PID" 2>/dev/null || true
  [[ -n "${CC_PROXY_PID:-}" ]] && kill "$CC_PROXY_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if ! pgrep -f "/usr/local/bin/vkwlf-cloudcode-proxy" >/dev/null 2>&1; then
  /usr/local/bin/vkwlf-cloudcode-proxy > "$RT/cloudcode-proxy.log" 2>&1 &
  CC_PROXY_PID=$!
fi

while true; do
  if ! pgrep -f "/usr/local/bin/vkwlf-cloudcode-proxy" >/dev/null 2>&1; then
    /usr/local/bin/vkwlf-cloudcode-proxy > "$RT/cloudcode-proxy.log" 2>&1 &
    CC_PROXY_PID=$!
  fi

  HOST="$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')"
  [[ -z "$HOST" ]] && HOST="10.60.251.164"

  rm -f "$SOCK" "$SOCK.lock"
  /usr/local/bin/vkwlf_guest_proxy --socket "$SOCK" --host-ip "$HOST" --tcp-port 5555 --vsock-port 0 --width 2382 --height 1299 > "$RT/proxy.log" 2>&1 &
  PROXY_PID=$!

  for _ in $(seq 1 50); do
    [[ -S "$SOCK" ]] && break
    kill -0 "$PROXY_PID" 2>/dev/null || break
    sleep 0.05
  done

  while [[ -S "$SOCK" ]] && kill -0 "$PROXY_PID" 2>/dev/null; do
    if ! pgrep -x antigravity >/dev/null 2>&1; then
      XDG_RUNTIME_DIR="$RT" WAYLAND_DISPLAY="wayland-0" ELECTRON_OZONE_PLATFORM_HINT=wayland NODE_TLS_REJECT_UNAUTHORIZED=0 \
        /usr/share/antigravity/antigravity \
        --ozone-platform=wayland \
        --enable-features=UseOzonePlatform \
        --disable-gpu \
        --ignore-certificate-errors \
        --user-data-dir="$HOME/.config/Antigravity-vkwlf" \
        "$HOME/VlkWlfApp" > "$RT/antigravity.log" 2>&1 &
      sleep 2
    fi
    sleep 1
  done

  pkill -x antigravity 2>/dev/null || true
  sleep 1
done
