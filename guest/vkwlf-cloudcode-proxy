#!/usr/bin/env python3
import http.client
import http.server
import json
import socketserver
import ssl
import sys

UPSTREAM_HOST = "daily-cloudcode-pa.googleapis.com"
PORT = 18981

PLACEHOLDER_MAP = {
    "MODEL_PLACEHOLDER_M400": "MODEL_PLACEHOLDER_M40",
    "MODEL_PLACEHOLDER_M401": "MODEL_PLACEHOLDER_M41",
    "MODEL_PLACEHOLDER_M402": "MODEL_PLACEHOLDER_M42",
    "MODEL_PLACEHOLDER_M403": "MODEL_PLACEHOLDER_M43",
    "MODEL_PLACEHOLDER_M404": "MODEL_PLACEHOLDER_M44",
    "MODEL_PLACEHOLDER_M405": "MODEL_PLACEHOLDER_M45",
    "MODEL_PLACEHOLDER_M187": "MODEL_PLACEHOLDER_M46",
    "MODEL_PLACEHOLDER_M198": "MODEL_PLACEHOLDER_M47",
    "MODEL_PLACEHOLDER_M322": "MODEL_PLACEHOLDER_M48",
}


def transform_available_models(raw_bytes: bytes) -> bytes:
    try:
        data = json.loads(raw_bytes.decode("utf-8"))
        models = data.get("models")
        if isinstance(models, dict):
            for model_id, info in models.items():
                if not isinstance(info, dict):
                    continue
                m = info.get("model")
                if m in PLACEHOLDER_MAP:
                    info["model"] = PLACEHOLDER_MAP[m]
                if model_id == "gemini-3.8-flash-tiered" and not info.get("displayName"):
                    info["displayName"] = "Gemini 3.8 Flash"
                    info["recommended"] = True
                me = info.get("modelExperiments")
                if isinstance(me, dict):
                    exps = me.get("experiments")
                    if isinstance(exps, dict):
                        fixed_exps = {}
                        for ek, ev in exps.items():
                            fixed_exps[ek.replace("_", "-")] = ev
                        me["experiments"] = fixed_exps
            sorts = data.get("agentModelSorts")
            if isinstance(sorts, list) and sorts:
                groups = sorts[0].get("groups")
                if isinstance(groups, list) and groups:
                    mids = groups[0].get("modelIds")
                    if isinstance(mids, list):
                        for extra in ["gemini-3.8-flash-tiered", "gemini-3-flash"]:
                            if extra in models and extra not in mids:
                                mids.insert(0, extra)
        out = json.dumps(data).encode("utf-8")
        print(f"[proxy] Transformed fetchAvailableModels ({len(raw_bytes)} -> {len(out)} bytes)", file=sys.stderr, flush=True)
        return out
    except Exception as e:
        print(f"[proxy] Error in transform_available_models: {e}", file=sys.stderr, flush=True)
        return raw_bytes


class ThreadedHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class CloudCodeProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, format, *args):
        print(f"[proxy] {self.command} {self.path} - {format % args}", file=sys.stderr, flush=True)

    def _read_request_body(self) -> bytes | None:
        te = self.headers.get("Transfer-Encoding", "").lower()
        if "chunked" in te:
            chunks = []
            while True:
                line = self.rfile.readline()
                if not line:
                    break
                size_str = line.split(b";", 1)[0].strip()
                if not size_str:
                    continue
                chunk_len = int(size_str, 16)
                if chunk_len == 0:
                    while True:
                        trailer = self.rfile.readline()
                        if not trailer or trailer in (b"\r\n", b"\n"):
                            break
                    break
                chunks.append(self.rfile.read(chunk_len))
                self.rfile.read(2)  # CRLF after chunk
            return b"".join(chunks)
        content_len = int(self.headers.get("Content-Length", 0))
        return self.rfile.read(content_len) if content_len > 0 else None

    def _handle_request(self):
        body = self._read_request_body()

        fwd_headers = {}
        for k, v in self.headers.items():
            kl = k.lower()
            if kl in ("host", "connection", "transfer-encoding", "accept-encoding", "content-length"):
                continue
            fwd_headers[k] = v
        fwd_headers["Host"] = UPSTREAM_HOST
        fwd_headers["Accept-Encoding"] = "identity"
        if body is not None:
            fwd_headers["Content-Length"] = str(len(body))

        ctx = ssl.create_default_context()
        conn = http.client.HTTPSConnection(UPSTREAM_HOST, 443, context=ctx, timeout=120)
        try:
            conn.request(self.command, self.path, body=body, headers=fwd_headers)
            resp = conn.getresponse()

            is_fetch_models = "fetchAvailableModels" in self.path
            content_type = resp.getheader("Content-Type", "")
            is_sse = "text/event-stream" in content_type.lower() or "alt=sse" in self.path

            if resp.status >= 400 and "streamGenerateContent" in self.path:
                err_body = resp.read()
                print(f"[proxy] {resp.status} ERROR on {self.path} body_len={len(body or b'')} resp={err_body.decode('utf-8', errors='replace')}", file=sys.stderr, flush=True)
                self.send_response(resp.status, resp.reason)
                for hk, hv in resp.getheaders():
                    if hk.lower() in ("content-length", "transfer-encoding", "connection"):
                        continue
                    self.send_header(hk, hv)
                self.send_header("Content-Length", str(len(err_body)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(err_body)
                self.wfile.flush()
                return

            if is_fetch_models and resp.status == 200:
                resp_body = resp.read()
                resp_body = transform_available_models(resp_body)
                self.send_response(resp.status, resp.reason)
                for hk, hv in resp.getheaders():
                    if hk.lower() in ("content-length", "transfer-encoding", "connection", "content-encoding"):
                        continue
                    self.send_header(hk, hv)
                self.send_header("Content-Length", str(len(resp_body)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(resp_body)
                self.wfile.flush()
            elif is_sse:
                self.send_response(resp.status, resp.reason)
                for hk, hv in resp.getheaders():
                    if hk.lower() in ("transfer-encoding", "connection", "content-length"):
                        continue
                    self.send_header(hk, hv)
                self.send_header("Connection", "close")
                self.end_headers()
                while True:
                    chunk = resp.read(4096)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    self.wfile.flush()
            else:
                resp_body = resp.read()
                self.send_response(resp.status, resp.reason)
                for hk, hv in resp.getheaders():
                    if hk.lower() in ("content-length", "transfer-encoding", "connection"):
                        continue
                    self.send_header(hk, hv)
                self.send_header("Content-Length", str(len(resp_body)))
                self.send_header("Connection", "close")
                self.end_headers()
                if resp_body:
                    self.wfile.write(resp_body)
                    self.wfile.flush()
        except Exception as e:
            print(f"[proxy] Upstream error on {self.path}: {e}", file=sys.stderr, flush=True)
            try:
                msg = str(e).encode("utf-8")
                self.send_response(502, "Bad Gateway")
                self.send_header("Content-Length", str(len(msg)))
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(msg)
            except Exception:
                pass
        finally:
            conn.close()

    def do_GET(self):
        self._handle_request()

    def do_POST(self):
        self._handle_request()

    def do_PUT(self):
        self._handle_request()

    def do_DELETE(self):
        self._handle_request()


if __name__ == "__main__":
    server = ThreadedHTTPServer(("127.0.0.1", PORT), CloudCodeProxyHandler)
    server.serve_forever()
