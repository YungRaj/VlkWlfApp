            android:roundIcon="@drawable/ic_app_antigravity"
            android:taskAffinity="com.google.example.vkwlf.task.primary"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|colorMode|locale|mcc|mnc|touchscreen">
            <layout
                android:defaultWidth="1400dp"
                android:defaultHeight="900dp"
                android:gravity="top|start"
                android:minWidth="480dp"
                android:minHeight="360dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

