<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.google.example.vkwlf"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="false" />

    <application
        android:label="@string/wayland_app_name"
        android:icon="@drawable/ic_wayland_app"
        android:roundIcon="@drawable/ic_wayland_app"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:debuggable="true">
        <activity
            android:name=".MainActivity"
            android:label="@string/wayland_app_name"
            android:icon="@drawable/ic_wayland_app"
            android:roundIcon="@drawable/ic_wayland_app"
            android:taskAffinity="com.google.example.vkwlf.task.primary"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|colorMode|locale|mcc|mnc|touchscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SecondaryWaylandActivity"
            android:label="@string/app_name_teamviewer"
            android:icon="@drawable/ic_app_teamviewer"
            android:roundIcon="@drawable/ic_app_teamviewer"
            android:taskAffinity="com.google.example.vkwlf.task.secondary"
            android:documentLaunchMode="intoExisting"
            android:resizeableActivity="true"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|colorMode|locale|mcc|mnc|touchscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
